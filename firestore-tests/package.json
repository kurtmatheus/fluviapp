{
  "name": "fluviapp-firestore-rules-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Suíte de testes das regras do Firestore (ADR-0011) no emulador — trava a paridade com PermissoesUsuario.kt.",
  "scripts": {
    "test": "npx firebase emulators:exec --only firestore --project demo-fluviapp --config ../firebase.json \"jest\"",
    "test:watch": "npx firebase emulators:exec --only firestore --project demo-fluviapp --config ../firebase.json \"jest --watch\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.0",
    "firebase-tools": "^13.29.1",
    "jest": "^29.7.0"
  }
}