rules_version = '2';

// Fronteira de autorização por cargo (ADR-0011). Espelha PermissoesUsuario.kt — a mesma matriz do
// ADR-0010, agora imposta no servidor. O cargo é lido de users/{uid}; a posse, do funcionarioId da
// passagem (ADR-0008/0010 Fase 2). Mudou um papel? Mude AQUI e no Kotlin — os dois são a fonte.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---

    function autenticado() {
      return request.auth != null;
    }

    // Perfil do autor (users/{uid}). Chamado só após autenticado() num && (short-circuit protege o get).
    function cargo() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cargo;
    }

    function cargoConhecido() {
      return cargo() in ['ADM', 'GESTOR', 'SUPERVISOR', 'AGENTE'];
    }

    // Cargos de PLATAFORMA (FluviApp), por oposição aos de agência (SUPERVISOR/AGENTE) — ADR-0015 §4.1/§4.2.
    // Espelha PermissoesUsuario.ehCargoPlataforma.
    function ehCargoPlataforma() {
      return cargo() in ['ADM', 'GESTOR'];
    }

    function podeEditarQualquerPassagem() {
      return ehCargoPlataforma() || cargo() == 'SUPERVISOR';
    }

    function ehDonoPassagem() {
      return resource.data.funcionarioId == request.auth.uid;
    }

    // Embarque é um eixo NOVO (ADR-0012): validar embarque ≠ editar conteúdo. Quem está na doca valida,
    // mesmo sem ter vendido → qualquer cargo conhecido. NÃO colapsar em podeEditarQualquerPassagem.
    function podeConfirmarEmbarque() {
      return cargoConhecido();
    }

    // --- Ciclo de vida da passagem (ADR-0012): a FSM Kotlin (StatusPassagem) imposta no servidor ---
    // Tolerante à grafia legada só na leitura (espelha StatusPassagem.de): "A EMITIR" → "A_EMITIR".
    // A escrita é sempre canônica (Fase 1), então normalizamos apenas o valor legado conhecido.
    function normStatus(s) {
      return s == 'A EMITIR' ? 'A_EMITIR' : s;
    }
    function statusAtual() {
      return normStatus(resource.data.get('status', ''));
    }
    function statusNovo() {
      return normStatus(request.resource.data.get('status', ''));
    }
    // Só as arestas legais da FSM (mesma matriz do Kotlin) ou status inalterado (edição de conteúdo).
    // Bloqueia retrocesso (EMBARCADA→*) e pulo (A_EMITIR→EMBARCADA sem passar por EMITIDA).
    function transicaoStatusLegal() {
      return statusAtual() == statusNovo()
          || (statusAtual() == 'A_EMITIR' && statusNovo() == 'EMITIDA')
          || (statusAtual() == 'EMITIDA' && statusNovo() == 'EMBARCADA');
    }
    // Confirmação de embarque: a aresta EMITIDA→EMBARCADA que (a) toca SÓ os 4 campos do embarque —
    // sem contrabandear edição de conteúdo por não-dono — e (b) carimba o PRÓPRIO uid como quem embarcou
    // (não dá forjar autoria, como o funcionarioId==uid da emissão), com nome e timestamp presentes.
    function embarqueCarimbado() {
      return request.resource.data.get('embarcadaPorId', '') == request.auth.uid
          && request.resource.data.get('embarcadaPor', '') != ''
          && request.resource.data.get('embarcadaEm', '') != '';
    }
    function ehConfirmacaoEmbarque() {
      return statusAtual() == 'EMITIDA'
          && statusNovo() == 'EMBARCADA'
          && embarqueCarimbado()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'embarcadaPorId', 'embarcadaPor', 'embarcadaEm']);
    }

    // --- Perfis de usuário: cargo imutável pelo cliente (anti-escalonamento) ---
    match /users/{uid} {
      allow read: if autenticado();
      // Provisionamento: só o próprio dono, e sempre no menor privilégio (nunca nasce ADM pelo cliente).
      allow create: if autenticado()
                    && request.auth.uid == uid
                    && request.resource.data.cargo == 'AGENTE';
      // Edita o próprio perfil, mas NUNCA o cargo (promoção é operação de console/backend).
      allow update: if autenticado()
                    && request.auth.uid == uid
                    && request.resource.data.cargo == resource.data.cargo;
      allow delete: if false;
    }

    // --- Catálogos / master data: leitura p/ todo autenticado (venda lê), escrita só cargo de plataforma ---
    match /constants/{doc} {
      allow read: if autenticado();
      allow write: if autenticado() && ehCargoPlataforma();
    }
    match /empresas/{doc} {
      allow read: if autenticado();
      allow write: if autenticado() && ehCargoPlataforma();
    }
    match /navios/{doc} {
      allow read: if autenticado();
      allow write: if autenticado() && ehCargoPlataforma();
    }
    match /agents/{doc} {
      allow read: if autenticado();
      allow write: if autenticado() && ehCargoPlataforma();
    }
    match /viagens/{doc} {
      allow read: if autenticado();
      allow write: if autenticado() && ehCargoPlataforma();
    }

    // --- Passagens: create sem forjar dono; update/delete por posse ou editar-qualquer ---
    match /passagens/{id} {
      allow read: if autenticado();

      // Doc especial do contador de bilhete (passagens/contador): quem emite passagem incrementa
      // o número. Endurecido — o contador é infra compartilhada, então o cargo certo ainda escreve,
      // mas só preservando o invariante: incremento MONOTÔNICO (nunca retrocede → sem bilhete
      // duplicado por rewind) e SEM delete (não é concedido → default-deny). Bootstrap/seed via create.
      // (A corrida de dois clientes no mesmo N não é resolvível por regra — exige transação no app.)
      allow create: if autenticado() && id == 'contador' && cargoConhecido();
      allow update: if autenticado() && id == 'contador' && cargoConhecido()
                    && request.resource.data.numeroBilhete > resource.data.get('numeroBilhete', -1);

      // Emissão: cargo conhecido e o dono declarado tem que ser o próprio autor (não dá forjar).
      allow create: if autenticado()
                    && id != 'contador'
                    && cargoConhecido()
                    && request.resource.data.funcionarioId == request.auth.uid;

      // Editar: o funcionarioId é sempre imutável (não reatribui dono) e o status só percorre arestas
      // legais da FSM (ADR-0012), nunca retrocede nem pula. Dois eixos de autorização:
      //  - confirmação de embarque (EMITIDA→EMBARCADA, carimbada): QUALQUER cargo conhecido (eixo novo);
      //  - qualquer outra edição (inclui emitir A_EMITIR→EMITIDA): plataforma/Supervisor ou o dono.
      allow update: if autenticado()
                    && id != 'contador'
                    && request.resource.data.funcionarioId == resource.data.funcionarioId
                    && transicaoStatusLegal()
                    && (ehConfirmacaoEmbarque()
                          ? podeConfirmarEmbarque()
                          : (podeEditarQualquerPassagem() || ehDonoPassagem()));

      // Deletar: mesmas regras de editar (ADR-0010).
      allow delete: if autenticado()
                    && id != 'contador'
                    && (podeEditarQualquerPassagem() || ehDonoPassagem());
    }

    // Coleções não listadas: negadas por omissão (default-deny).
  }
}
