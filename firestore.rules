rules_version = '2';

// Fronteira de autorização (ADR-0011). Espelha PermissoesUsuario.kt — a mesma matriz do ADR-0010,
// agora imposta no servidor. Depois da revisão estrutural (ADR-0015 §8) são DOIS eixos: o **papel** de
// sistema vem de users/{uid}; o **cargo** de negócio vem do funcionário ligado, alcançado pelo
// funcionarioId do perfil (§8.3). A posse da passagem também é do funcionário (§8.4).
// Mudou um dos eixos? Mude AQUI e no Kotlin — os dois são a fonte.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---

    function autenticado() {
      return request.auth != null;
    }

    // Perfil do autor (users/{uid}). Chamado só após autenticado() num && (short-circuit protege o get).
    function perfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Eixo SISTEMA.
    function papel() {
      return perfil().get('papel', '');
    }

    function papelConhecido() {
      return papel() in ['ADM', 'GESTOR', 'OPERADOR'];
    }

    // Papéis de PLATAFORMA (FluviApp), por oposição a OPERADOR — ADR-0015 §4.1/§8.1.
    // Espelha PermissoesUsuario.ehPapelPlataforma.
    function ehPapelPlataforma() {
      return papel() in ['ADM', 'GESTOR'];
    }

    // Administração de ACESSO é só do ADM (ADR-0021 D1): papel concede tudo, e erro aqui é sistêmico.
    function ehAdm() {
      return papel() == 'ADM';
    }

    // --- Convite (F6.6): quem pode entrar, e com que papel ---
    // É ele que substitui o console para tudo, menos o primeiro ADM (que continua bootstrap, ADR-0021 D0).
    function temConvite(email) {
      return exists(/databases/$(database)/documents/convites/$(email));
    }
    // Sem convite, o papel possível é OPERADOR — que é exatamente o comportamento anterior à F6.6, e é
    // o que mantém quem foi pré-cadastrado antes dela conseguindo entrar.
    function papelDoConvite() {
      return temConvite(request.auth.token.email)
        ? get(/databases/$(database)/documents/convites/$(request.auth.token.email)).data.get('papel', 'OPERADOR')
        : 'OPERADOR';
    }

    // Espelha o enum Atuacao (ADR-0020 D5). Conjunto FECHADO: valor novo aqui exige deploy dos dois
    // lados, e é essa exigência que impede alguém cadastrar uma atuação que nenhum código sabe operar.
    function atuacaoConhecida(id) {
      return id in ['AGENCIAMENTO', 'TRANSPORTE', 'PORTUARIA_OPERACAO', 'PORTUARIA_ARRENDAMENTO'];
    }

    // Elo 1-1 com a operação (ADR-0015 §8.3). Vazio = papel puro de plataforma, que é estado VÁLIDO.
    function funcionarioIdDoAutor() {
      return perfil().get('funcionarioId', '');
    }

    // Eixo NEGÓCIO: o 2º salto. Fail-closed EXPLÍCITO — sem elo ou com elo apontando para documento
    // inexistente, devolve '' em vez de estourar a avaliação por acidente.
    function cargoDoAutor() {
      return funcionarioIdDoAutor() != ''
          && exists(/databases/$(database)/documents/funcionarios/$(funcionarioIdDoAutor()))
        ? get(/databases/$(database)/documents/funcionarios/$(funcionarioIdDoAutor())).data.get('cargo', '')
        : '';
    }

    // Os dois eixos se encontram aqui (ADR-0015 §8.2), como no Kotlin.
    function podeEditarQualquerPassagem() {
      return ehPapelPlataforma() || cargoDoAutor() == 'SUPERVISOR';
    }

    // Posse = o FUNCIONÁRIO que emitiu (ADR-0015 §8.4), não o uid. Sem elo não há posse: '' não casa
    // com nada, senão dois perfis sem vínculo seriam "donos" das passagens um do outro.
    function ehDonoPassagem() {
      return funcionarioIdDoAutor() != ''
          && resource.data.funcionarioId == funcionarioIdDoAutor();
    }

    // Embarque é um eixo NOVO (ADR-0012): validar embarque ≠ editar conteúdo. Quem está na doca valida,
    // mesmo sem ter vendido → qualquer papel conhecido. NÃO colapsar em podeEditarQualquerPassagem.
    function podeConfirmarEmbarque() {
      return papelConhecido();
    }

    // --- Ciclo de vida da passagem (ADR-0012): a FSM Kotlin (StatusPassagem) imposta no servidor ---
    // Tolerante à grafia legada só na leitura (espelha StatusPassagem.de): "A EMITIR" → "A_EMITIR".
    // A escrita é sempre canônica (Fase 1), então normalizamos apenas o valor legado conhecido.
    function normStatus(s) {
      return s == 'A EMITIR' ? 'A_EMITIR' : s;
    }
    function statusAtual() {
      return normStatus(resource.data.get('status', ''));
    }
    function statusNovo() {
      return normStatus(request.resource.data.get('status', ''));
    }
    // Só as arestas legais da FSM (mesma matriz do Kotlin) ou status inalterado (edição de conteúdo).
    // Bloqueia retrocesso (EMBARCADA→*) e pulo (A_EMITIR→EMBARCADA sem passar por EMITIDA).
    //
    // **CANCELADA entra na matriz com o delete saindo do arquivo** (F9.2, ADR-0024 D11), e as duas coisas
    // são a mesma decisão: cancelar deixou de ser remoção física e virou estado. Ela é alcançável de
    // A_EMITIR e de EMITIDA, e **nunca de EMBARCADA** — quem já embarcou não cancela a travessia; o que
    // existe depois disso é acerto financeiro, e acerto é do módulo de faturamento.
    function transicaoStatusLegal() {
      return statusAtual() == statusNovo()
          || (statusAtual() == 'A_EMITIR' && statusNovo() == 'EMITIDA')
          || (statusAtual() == 'EMITIDA' && statusNovo() == 'EMBARCADA')
          || (statusAtual() == 'A_EMITIR' && statusNovo() == 'CANCELADA')
          || (statusAtual() == 'EMITIDA' && statusNovo() == 'CANCELADA');
    }
    // Confirmação de embarque: a aresta EMITIDA→EMBARCADA que (a) toca SÓ os campos do embarque — sem
    // contrabandear edição de conteúdo por não-dono — e (b) carimba o PRÓPRIO uid como quem embarcou.
    // Aqui é uid mesmo, não funcionário: é auditoria de ACESSO, e só o uid o servidor pode conferir
    // contra request.auth (ADR-0015 §8.4 mudou a posse, não o carimbo).
    //
    // O carimbo virou **sub-objeto** `embarque: {porId, em}` (ADR-0018 D14): eram três campos planos com
    // default vazio, e isso deixava representável o meio-preenchido — autoria sem instante, ou o inverso.
    // O nome de quem validou **saiu**: no domínio nada é congelado, e ele se resolve por referência.
    function embarqueCarimbado() {
      return request.resource.data.get('embarque', {}).get('porId', '') == request.auth.uid
          && request.resource.data.get('embarque', {}).get('em', '') != '';
    }
    function ehConfirmacaoEmbarque() {
      return statusAtual() == 'EMITIDA'
          && statusNovo() == 'EMBARCADA'
          && embarqueCarimbado()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'embarque', 'alteradoEm']);
    }

    // --- Perfis de usuário: papel e vínculo imutáveis pelo cliente (anti-escalonamento) ---
    match /users/{uid} {
      allow read: if autenticado();
      // Provisionamento = **primeiro acesso** (ADR-0015 §2.1), e só ele: o autocadastro saiu em P2.2c.
      // Três exigências, e a terceira é a que fecha o buraco que P2.2a′ tinha deixado aberto:
      //  1. só o próprio dono (uid do doc == uid autenticado);
      //  2. sempre no menor privilégio — nunca nasce ADM/GESTOR pelo cliente (esses vêm do console);
      //  3. o vínculo declarado tem de apontar para um funcionário **com o mesmo e-mail** do autenticado.
      //     Sem isso, escrever o próprio funcionarioId seria escolher de quem são as passagens que ele
      //     "possui" (§8.4) — é o e-mail, gravado pela gestão no pré-cadastro, que autoriza o elo.
      function vinculoConfereComOEmail(fid) {
        return fid != ''
            && exists(/databases/$(database)/documents/funcionarios/$(fid))
            && get(/databases/$(database)/documents/funcionarios/$(fid)).data.get('email', '')
                 == request.auth.token.email;
      }
      // **O papel vem do CONVITE** (F6.6), e não mais fixo em OPERADOR. O anti-escalonamento continua
      // inteiro: o cliente não escolhe o próprio papel — ele tem de bater com um documento que só o ADM
      // escreve. Sem convite, o único papel possível segue sendo OPERADOR.
      // O elo com a operação é exigido **só de quem opera**: ADM/GESTOR não têm funcionário (§8.1).
      allow create: if autenticado()
                    && request.auth.uid == uid
                    && request.resource.data.papel == papelDoConvite()
                    && (request.resource.data.papel != 'OPERADOR'
                        || vinculoConfereComOEmail(request.resource.data.get('funcionarioId', '')));
      // Edita o próprio perfil, mas NUNCA o papel nem o vínculo (ambos são operação de console/gestão).
      allow update: if autenticado()
                    && request.auth.uid == uid
                    && request.resource.data.papel == resource.data.papel
                    && request.resource.data.get('funcionarioId', '')
                         == resource.data.get('funcionarioId', '');
      allow delete: if false;
    }

    // --- Rotas: o pool compartilhado (ADR-0016 §7.1, ADR-0022 D3 — F7) ---
    //
    // Sem dono, legível por todos, e com três verbos governados por três autoridades diferentes:
    //
    //  1. **criar** é da plataforma e do SUPERVISOR, em qualquer par de portos (decisão do analista): a
    //     rota é a *ligação*, e ela existe no mundo independentemente de quem pode vendê-la. O recorte
    //     do que a empresa oferta é da viagem (F8), onde a concessão entra;
    //  2. **editar não existe para ninguém.** A única alteração admitida é o campo `ativo` — corrigir é
    //     criar outra e inativar esta. Um `update` livre mudaria, retroativamente, o significado de
    //     viagens e bilhetes de terceiros;
    //  3. **inativar é só da plataforma**: é o único ato daqui que atinge quem nem sabe que a rota
    //     existe. Quem quer apenas não vê-la usa a lista de negadas da própria atuação (F8).
    //
    // **O que esta regra NÃO impõe, e por quê:** a unicidade do par. Regra não consulta coleção, e a
    // saída usual — derivar o id do documento do par — brigaria com a recriação: inativada uma rota,
    // recriar o mesmo par colidiria com o id da anterior, e é exatamente esse gesto que a imutabilidade
    // exige. A verificação fica no cadastro (impede o acidente, não a corrida), como no Porto.
    match /rotas/{doc} {
      allow read: if autenticado();

      allow create: if autenticado() && (ehPapelPlataforma() || cargoDoAutor() == 'SUPERVISOR');

      allow update: if autenticado()
                    && ehPapelPlataforma()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo']);

      allow delete: if false;
    }

    // --- Convites: quem pode entrar, e com que papel (F6.6) ---
    //
    // O id **é o e-mail**, e isso é o que torna a regra possível: o convidado lê o próprio convite com um
    // `get` direto, **antes** de existir `users/{uid}` — não há papel a consultar nesse instante, então a
    // única autoridade disponível é o e-mail do token.
    match /convites/{email} {
      // O próprio convidado lê o dele; a plataforma lê todos (é ela quem administra o acesso).
      allow get: if autenticado() && (request.auth.token.email == email || ehAdm());
      allow list: if autenticado() && ehAdm();

      allow create: if autenticado() && ehAdm();

      // Duas escritas possíveis, e a segunda é estreita de propósito: o convidado só marca o convite
      // como **usado**, e nada mais. A ordem das cláusulas importa — a do dono vem primeiro porque ela
      // não depende de `users/{uid}`, que nesse momento ainda não existe.
      allow update: if autenticado()
                    && ((request.auth.token.email == email
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado'])
                         && request.resource.data.usado == true)
                        || ehAdm());

      // O convite **vira registro**: usado ou não, ele responde "por que esta pessoa tem este papel?".
      allow delete: if false;
    }

    // --- Equipe: o registro de negócio — ADR-0015 §2.1/§8.5, reescrito na F6.3 sobre VÍNCULOS ---
    //
    // A autoridade deixou de ser a String de agência e passou a ser o **vínculo** `{empresaId, cargo}`
    // (ADR-0016 §6). Dois escritores, com alcances diferentes: a **plataforma** em qualquer empresa, e o
    // **supervisor** só na dele. Três invariantes, os mesmos de antes com a coordenada nova:
    //  1. NINGUÉM muda os próprios vínculos — nem um ADM no funcionário dele mesmo. É o anti-escalonamento
    //     do eixo de negócio, já que cargo == SUPERVISOR concede editar-qualquer-passagem;
    //  2. o supervisor **gere a equipe dele por inteiro** (F6.7): cadastra, promove e remove — dentro da
    //     empresa dele. Promover concede poder numa empresa só, e isso é decisão de negócio dela;
    //  3. o supervisor não move ninguém para fora nem traz de fora: os vínculos de origem E de destino
    //     têm de ser só os dele, senão o isolamento por empresa (§3) seria contornável por edição.
    //
    // **Como isso é verificável numa regra**: a linguagem não itera array, mas compara elementos inteiros.
    // Como o vínculo tem forma fechada (`{empresaId, cargo}`), `hasOnly([{...}])` diz exatamente
    // *"todo vínculo desta pessoa é este"* — e é isso que fecha o cerco sem precisar de campo derivado
    // extra só para a regra.
    function vinculosDoAutor() {
      return funcionarioIdDoAutor() != ''
          && exists(/databases/$(database)/documents/funcionarios/$(funcionarioIdDoAutor()))
        ? get(/databases/$(database)/documents/funcionarios/$(funcionarioIdDoAutor())).data.get('vinculos', [])
        : [];
    }
    function ehSupervisor() {
      return cargoDoAutor() == 'SUPERVISOR';
    }
    // Supervisiono esta empresa? (procura o par exato no MEU documento)
    function souSupervisorDe(empresaId) {
      return vinculosDoAutor().hasAny([{'empresaId': empresaId, 'cargo': 'SUPERVISOR'}]);
    }
    // O alvo é **exclusivamente da minha empresa**: um vínculo só, e numa empresa que eu supervisiono.
    //
    // O cargo dele pode ser AGENTE **ou SUPERVISOR** desde a F6.7: promover concede poder dentro de uma
    // empresa só, e isso é decisão de negócio dela. O que continua impossível é o supervisor mexer nos
    // PRÓPRIOS vínculos (`naoMexeNosPropriosVinculos`) e alcançar quem serve a duas empresas — porque
    // metade dos vínculos dessa pessoa não é dele.
    function soDaMinhaEmpresa(vinculos) {
      return vinculos.size() == 1
          && souSupervisorDe(vinculos[0].empresaId)
          && vinculos[0].cargo in ['AGENTE', 'SUPERVISOR'];
    }
    function vinculosInalterados() {
      return request.resource.data.get('vinculos', []) == resource.data.get('vinculos', []);
    }
    function naoMexeNosPropriosVinculos(id) {
      return !(funcionarioIdDoAutor() == id && !vinculosInalterados());
    }

    match /funcionarios/{id} {
      allow read: if autenticado();

      allow create: if autenticado()
                    && (ehPapelPlataforma()
                        || (ehSupervisor() && soDaMinhaEmpresa(request.resource.data.get('vinculos', []))));

      allow update: if autenticado()
                    && (ehPapelPlataforma()
                        || (ehSupervisor()
                            // Origem e destino: quem já era só da minha empresa continua sendo.
                            && soDaMinhaEmpresa(resource.data.get('vinculos', []))
                            && soDaMinhaEmpresa(request.resource.data.get('vinculos', []))))
                    && naoMexeNosPropriosVinculos(id);

      // **Remover também é de quem gere** (F6.7): quem cuida da equipe cuida dela por inteiro. Duas
      // barreiras ficam: só alcança quem é exclusivamente da empresa dele, e **ninguém se apaga** — um
      // supervisor que se removesse deixaria a empresa sem quem a gerisse, sem ninguém decidir isso.
      allow delete: if autenticado()
                    && funcionarioIdDoAutor() != id
                    && (ehPapelPlataforma()
                        || (ehSupervisor() && soDaMinhaEmpresa(resource.data.get('vinculos', []))));
    }

    // --- Catálogos / master data: leitura p/ todo autenticado (venda lê), escrita só papel de plataforma ---
    match /constants/{doc} {
      allow read: if autenticado();
      allow write: if autenticado() && ehPapelPlataforma();
    }
    match /empresas/{empresaId} {
      allow read: if autenticado();
      allow write: if autenticado() && ehPapelPlataforma();

      // A PARTE exerce ATUAÇÕES (ADR-0016 §4). Subcoleção porque o conjunto muda ao longo do tempo e
      // porque **o id do documento é o nome da atuação** — o que só é possível desde que `Atuacao`
      // virou tipo fechado (ADR-0020 D5). O `{empresaId}` acima é wildcard de UM segmento e não
      // alcança filhos: sem este bloco, a subcoleção ficaria SEM REGRA (ou seja, negada por omissão).
      match /atuacoes/{atuacao} {
        // Leitura para todo autenticado: a operação precisa saber em que a empresa atua — é disso que
        // a família do menu deriva (§2) e é contra a concessão daqui que a venda é conferida (§7).
        allow read: if autenticado();

        // Escrita é do painel (§2/§6): quem cadastra parte e atuação é papel de plataforma.
        // `atuacaoConhecida` é o mesmo fail-closed do cliente, que descarta id desconhecido na
        // leitura — aqui ele é imposto na ORIGEM: não se cria atuação que o código não sabe operar.
        allow create, update: if autenticado() && ehPapelPlataforma() && atuacaoConhecida(atuacao);

        // Delete NÃO exige id conhecido, de propósito: se um documento inválido existir (semeado à
        // mão, migração antiga), tem de haver caminho para removê-lo. Regra que impede a limpeza do
        // próprio lixo vira lixo permanente.
        allow delete: if autenticado() && ehPapelPlataforma();
      }
    }
    // A coleção acompanhou o rename da entidade (`Navio` → `Embarcacao`): nem tudo que navega é navio, e
    // o domínio já dizia isso no tipo de embarcação. A seção do menu chama-se **Flotilha**.
    match /embarcacoes/{doc} {
      allow read: if autenticado();
      allow write: if autenticado() && ehPapelPlataforma();
    }
    // Capacidade da plataforma (ADR-0016 §5): sem dono, escrita só por papel de plataforma. Não há
    // `delete` porque não existe apagar aqui — excluir uma localidade é gravar `ativo: false`, que passa
    // pelo `write` acima. Regra que permitisse o delete físico contradiria o motivo do delete lógico:
    // o porto histórico ficaria apontando para um documento que não existe mais.
    match /localidades/{doc} {
      allow read: if autenticado();
      allow create, update: if autenticado() && ehPapelPlataforma();
      allow delete: if false;
    }
    // A outra capacidade da plataforma (ADR-0016 §5), com a mesma forma e pela mesma razão — um elo
    // adiante: o porto é referenciado pela rota e pela concessão da empresa, então aqui também não
    // existe apagar. Excluir um porto é gravar `ativo: false`, que passa pelo `update`.
    //
    // A unicidade `(nome, localidade)` do §5 NÃO está aqui: sem query na regra, verificá-la exigiria um
    // índice de documento por par, e a F8 é quem decide essa forma. Hoje ela é do cadastro — impede o
    // acidente, não a corrida.
    match /portos/{doc} {
      allow read: if autenticado();
      allow create, update: if autenticado() && ehPapelPlataforma();
      allow delete: if false;
    }
    // --- Viagens: a partida física sobre a rota (ADR-0016 §7.1, ADR-0022 D3 — F8) ---
    //
    // **Esta é a única regra do arquivo que a F8 corrige em vez de escrever.** O que estava aqui era um
    // `write` único da Viagem-trecho, e ele contrariava a D3 em três pontos ao mesmo tempo: não separava
    // criar de alterar, admitia **editar** (que não existe para ninguém) e admitia **apagar** (que
    // destruiria o registro para o qual as passagens apontam). Também deixava o `SUPERVISOR` de fora, e
    // é ele quem sabe que saída existe.
    //
    // Os três verbos e as três autoridades são os mesmos da rota, com o argumento elevado num deles:
    //
    //  1. **criar** é da plataforma e do SUPERVISOR. O que ele pode criar é recortado pela concessão, mas
    //     esse recorte é do cliente — a regra não consulta a atuação porque não é ela que impede o dano:
    //     criar viagem sobre rota alheia produz um documento inútil, não um acesso indevido, e o que
    //     protege a venda é a concessão sendo relida na emissão (F9);
    //  2. **editar não existe para ninguém**, e aqui pelo motivo mais forte do modelo: a viagem é o que a
    //     `Passagem` aponta. Um `update` livre mudaria a hora impressa em bilhete já emitido — por
    //     terceiros, retroativamente. A única alteração admitida é o campo `ativo`;
    //  3. **inativar é só da plataforma**: tirar do ar uma saída atinge quem já vendeu nela.
    //
    // **O que esta regra NÃO impõe, e por quê:** a unicidade da chave `(rotaId, embarcacaoId, diaSemana,
    // horaMin)`. Mesmo limite da rota, e a mesma saída recusada — derivar o id do documento da chave
    // brigaria com a recriação que a imutabilidade exige. Fica no cadastro, com caso de emulador
    // documentando o limite.
    match /viagens/{doc} {
      allow read: if autenticado();

      allow create: if autenticado() && (ehPapelPlataforma() || cargoDoAutor() == 'SUPERVISOR');

      allow update: if autenticado()
                    && ehPapelPlataforma()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo']);

      allow delete: if false;

      // --- O contador de bilhete, agora POR OCORRÊNCIA (F9.2, ADR-0024 D6) ---
      //
      // Era `passagens/contador`: um documento único, global, que nunca foi uma passagem e vivia dentro da
      // coleção de passagens com uma exceção por `id == 'contador'` em cada linha de regra. Agora é
      // `viagens/{viagemId}/ocorrencias/{data}`, guardando o último número daquela saída e **nada mais**.
      //
      // Três coisas que só a subcoleção dá, e a terceira é esta regra:
      //
      //  1. a chave composta deixa de ser texto concatenado (`viagemId_data`, que ninguém consulta por
      //     metade) e volta a ser **caminho** — "as ocorrências desta viagem" é a subcoleção inteira;
      //  2. a numeração deixa de ser global: dois bilhetes de saídas diferentes param de disputar o
      //     mesmo número;
      //  3. **a viagem-pai tem de existir** para nascer um contador para ela — o que uma chave
      //     concatenada na raiz não teria como exigir.
      //
      // O invariante permanece o mesmo do documento antigo, e é o que importa: **monotônico**, nunca
      // retrocede (rewind produziria bilhete duplicado) e **sem delete** — não concedido, default-deny.
      // Zerar um contador é reemitir números já impressos.
      //
      // A corrida entre dois caixas no mesmo N **não é resolvível por regra** (a regra vê uma escrita por
      // vez, não a leitura que a precedeu): quem a resolve é a transação no app, que lê do servidor e
      // grava no mesmo passo. A regra impede o retrocesso; a transação impede o empate.
      match /ocorrencias/{data} {
        allow read: if autenticado();

        allow create: if autenticado()
                      && papelConhecido()
                      && exists(/databases/$(database)/documents/viagens/$(doc))
                      && request.resource.data.ultimoNumero is int
                      && request.resource.data.ultimoNumero > 0;

        allow update: if autenticado()
                      && papelConhecido()
                      && request.resource.data.ultimoNumero is int
                      && request.resource.data.ultimoNumero > resource.data.get('ultimoNumero', -1);

        allow delete: if false;
      }
    }

    // --- Passagens: create sem forjar dono; update por posse ou editar-qualquer; **delete não existe** ---
    //
    // Duas exceções saíram deste bloco na F9.2, e vale dizer o que cada uma era:
    //
    //  - **o `id != 'contador'` repetido em cada verbo** morreu com o documento que o justificava. O
    //    contador nunca foi uma passagem, e vivia dentro de `passagens/` obrigando toda regra a abrir
    //    exceção para ele. Agora é subcoleção da viagem, e a regra dele mora lá;
    //  - **o `allow delete`** vira `if false`, entrando na lista das seis coleções que já registram fato e
    //    não admitem remoção (ADR-0024 D11). Não é um `if` com condição de cargo: se ninguém deve apagar, a
    //    condição é `false`, e isso é auditável de relance. O que existe é `CANCELADA`, que é transição —
    //    cancelada não ocupa, não fatura e **fica com o número**: sequência com buraco é o normal de uma
    //    numeração que registra fatos.
    //
    // **O que esta regra não consegue verificar, e está declarado em teste que passa de propósito:** a
    // consistência da lista de `lancamentos`. As regras não iteram — dá para exigir que o campo exista e
    // seja lista, não que cada item tenha forma conhecida e valor positivo. Com as quatro colunas de valor
    // uma regra podia ao menos falar de `valorPix`; com a lista, **o dinheiro passa a ser inteiramente
    // responsabilidade do cliente**. Sustenta-se porque lançamento inválido é dado ruim de quem já está
    // autorizado a vender, não escalonamento de privilégio.
    match /passagens/{id} {
      allow read: if autenticado();

      // Emissão: papel conhecido e o dono declarado tem que ser o FUNCIONÁRIO do autor (não dá forjar,
      // porque o cliente não escreve o próprio funcionarioId). Dono vazio é recusado: quem emite é da
      // operação (ADR-0015 §8.4) — sem isso, dois perfis de plataforma gerariam passagens órfãs.
      allow create: if autenticado()
                    && papelConhecido()
                    && funcionarioIdDoAutor() != ''
                    && request.resource.data.funcionarioId == funcionarioIdDoAutor();

      // Editar: o funcionarioId é sempre imutável (não reatribui dono) e o status só percorre arestas
      // legais da FSM (ADR-0012), nunca retrocede nem pula. Dois eixos de autorização:
      //  - confirmação de embarque (EMITIDA→EMBARCADA, carimbada): QUALQUER papel conhecido (eixo novo);
      //  - qualquer outra edição (inclui emitir A_EMITIR→EMITIDA e cancelar): plataforma/Supervisor ou o dono.
      allow update: if autenticado()
                    && request.resource.data.funcionarioId == resource.data.funcionarioId
                    && transicaoStatusLegal()
                    && (ehConfirmacaoEmbarque()
                          ? podeConfirmarEmbarque()
                          : (podeEditarQualquerPassagem() || ehDonoPassagem()));

      allow delete: if false;
    }

    // Coleções não listadas: negadas por omissão (default-deny).
  }
}